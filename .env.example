POSTGRES_USER=campus
POSTGRES_PASSWORD=campus
POSTGRES_DB=campus
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Generate your own before running anything you care about:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The value below is a PLACEHOLDER and is published in this repository —
# any token signed with it can be forged by anyone who has read it.
JWT_SECRET=replace-me-see-comment-above
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- benchmark builds -------------------------------------------------
# Each drops exactly ONE lock and changes no other logic, so the broken
# half of every benchmark table stays reproducible from a fresh clone.
# Both MUST be false for a correct build. See README, "The four benchmarks".
#   BENCHMARK_UNSAFE_NO_USER_LOCK=true      -> Benchmark 2's broken column
#   BENCHMARK_UNSAFE_NO_OFFERING_LOCK=true  -> Benchmarks 1 and 4's
